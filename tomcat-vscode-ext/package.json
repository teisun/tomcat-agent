{
  "name": "tomcat-vscode-ext",
  "displayName": "Tomcat",
  "description": "%extension.description%",
  "version": "0.1.85",
  "publisher": "tomcat",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/teisun/tomcat-agent.git"
  },
  "tomcat": {
    "bundledCliVersion": "0.1.71"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "keywords": [
    "tomcat",
    "agent",
    "ai",
    "assistant",
    "sidebar",
    "vscode"
  ],
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.104.0"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "tomcat.restartServe",
        "title": "%command.restartServe%"
      },
      {
        "command": "tomcat.session.new",
        "title": "%command.newSession%"
      },
      {
        "command": "tomcat.session.list",
        "title": "%command.listSessions%"
      },
      {
        "command": "tomcat.ui.focus",
        "title": "%command.focus%"
      },
      {
        "command": "tomcat.openSettings",
        "title": "%command.settings%"
      },
      {
        "category": "Tomcat",
        "command": "tomcat.addSelectionToChat",
        "icon": "$(comment-add)",
        "title": "%command.addSelection%"
      },
      {
        "category": "Tomcat",
        "command": "tomcat.addFileToChat",
        "icon": "$(file-add)",
        "title": "%command.addFile%"
      },
      {
        "category": "Tomcat Plan",
        "command": "tomcat.plan.build",
        "icon": "$(run)",
        "title": "%command.buildPlan%"
      },
      {
        "category": "Tomcat Plan",
        "command": "tomcat.plan.selectBuildModel",
        "icon": "$(sparkle)",
        "title": "%command.selectBuildModel%"
      },
      {
        "category": "Tomcat Plan",
        "command": "tomcat.plan.viewAsPreview",
        "title": "%command.preview%"
      },
      {
        "category": "Tomcat Plan",
        "command": "tomcat.plan.viewAsMarkdown",
        "title": "%command.markdown%"
      },
      {
        "category": "Tomcat Plan",
        "command": "tomcat.plan.addSelectionToChat",
        "icon": "$(comment-add)",
        "title": "%command.addSelection%"
      }
    ],
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "tomcat-sidebar",
          "title": "TOMCAT",
          "icon": "media/tomcat.svg"
        }
      ]
    },
    "views": {
      "tomcat-sidebar": [
        {
          "id": "tomcat.chatView",
          "name": "TOMCAT",
          "type": "webview"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "tomcat.planPreview",
        "displayName": "%editor.planPreview%",
        "selector": [
          {
            "filenamePattern": "*.plan.md"
          }
        ],
        "priority": "default"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "tomcat.addSelectionToChat",
          "group": "navigation@20",
          "when": "editorHasSelection && editorTextFocus"
        }
      ],
      "explorer/context": [
        {
          "command": "tomcat.addFileToChat",
          "group": "navigation@20"
        }
      ],
      "editor/title": [
        {
          "command": "tomcat.plan.build",
          "group": "navigation@1",
          "when": "activeCustomEditorId == 'tomcat.planPreview' && config.tomcat.plan.toolbarStyle == 'native' && tomcat.plan.canBuild"
        },
        {
          "command": "tomcat.plan.selectBuildModel",
          "group": "navigation@2",
          "when": "activeCustomEditorId == 'tomcat.planPreview' && config.tomcat.plan.toolbarStyle == 'native'"
        },
        {
          "command": "tomcat.plan.viewAsMarkdown",
          "group": "1_tcplanmode@1",
          "when": "activeCustomEditorId == 'tomcat.planPreview'"
        },
        {
          "command": "tomcat.plan.viewAsPreview",
          "group": "1_tcplanmode@1",
          "when": "resourceFilename =~ /\\.plan\\.md$/ && activeEditor == 'workbench.editors.files.textFileEditor'"
        }
      ],
      "webview/context": [
        {
          "command": "tomcat.plan.addSelectionToChat",
          "group": "navigation@20",
          "when": "webviewId == 'tomcat.planPreview'"
        }
      ],
      "commandPalette": [
        {
          "command": "tomcat.plan.addSelectionToChat",
          "when": "activeCustomEditorId == 'tomcat.planPreview'"
        },
        {
          "command": "tomcat.plan.build",
          "when": "activeCustomEditorId == 'tomcat.planPreview' && tomcat.plan.canBuild"
        },
        {
          "command": "tomcat.plan.selectBuildModel",
          "when": "activeCustomEditorId == 'tomcat.planPreview'"
        },
        {
          "command": "tomcat.plan.viewAsPreview",
          "when": "resourceFilename =~ /\\.plan\\.md$/ && activeEditor == 'workbench.editors.files.textFileEditor'"
        },
        {
          "command": "tomcat.plan.viewAsMarkdown",
          "when": "activeCustomEditorId == 'tomcat.planPreview'"
        }
      ]
    },
    "keybindings": [
      {
        "command": "tomcat.addSelectionToChat",
        "key": "ctrl+alt+a",
        "mac": "cmd+alt+a",
        "when": "editorTextFocus && editorHasSelection"
      }
    ],
    "configuration": {
      "title": "Tomcat",
      "properties": {
        "tomcat.path": {
          "type": "string",
          "default": "tomcat",
          "description": "%config.path%"
        },
        "tomcat.serve.extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%config.extraArgs%"
        },
        "tomcat.session.defaultCwd": {
          "type": "string",
          "default": "",
          "description": "%config.defaultCwd%"
        },
        "tomcat.layout.controlsInset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 40,
          "default": 15,
          "description": "%config.controlsInset%"
        },
        "tomcat.layout.contentInset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 40,
          "default": 25,
          "description": "%config.contentInset%"
        },
        "tomcat.contextSearch.maxFiles": {
          "type": "integer",
          "minimum": 1,
          "default": 20000,
          "description": "%config.maxFiles%"
        },
        "tomcat.plan.buildModel": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "%config.buildModel%"
        },
        "tomcat.plan.toolbarStyle": {
          "type": "string",
          "enum": [
            "hybrid",
            "native"
          ],
          "enumDescriptions": [
            "%config.toolbarHybrid%",
            "%config.toolbarNative%"
          ],
          "default": "hybrid",
          "description": "%config.toolbarStyle%"
        }
      }
    }
  },
  "scripts": {
    "clean": "rm -rf out dist .vscode-test .wire-tmp *.vsix",
    "build:gui": "npm --prefix gui run build",
    "gen:wire": "tsx scripts/gen-wire.ts",
    "check:wire": "tsx scripts/gen-wire.ts --check",
    "compile": "tsc -p tsconfig.json",
    "build": "npm run gen:wire && npm run build:gui && npm run compile && tsx scripts/buildArtifacts.ts",
    "watch": "npm run gen:wire && tsc -watch -p tsconfig.json",
    "lint:extension": "tsc -p tsconfig.json --noEmit",
    "lint": "npm run lint:extension && npm --prefix gui run lint",
    "test:unit:gui": "npm --prefix gui run test",
    "test:unit:core": "vitest run --maxWorkers 4 src",
    "test:unit": "npm run test:unit:core && npm run test:unit:gui",
    "test:integration": "vitest run --config vitest.integration.config.ts --maxWorkers 1",
    "test:e2e:vscode-devhost": "tsx scripts/run-vscode-devhost.ts",
    "test:e2e:vscode-install": "tsx scripts/run-vscode-install-e2e.ts",
    "test:e2e:webview-devhost": "tsx scripts/run-vscode-devhost.ts",
    "test:e2e:webview-degraded": "TOMCAT_VSCODE_TEST_BOOTSTRAP_LIST_MODELS_FAILURES=1 TOMCAT_E2E_GREP='connected-but-degraded' npm run test:e2e:webview-devhost",
    "test:e2e:webview-stop": "TOMCAT_E2E_GREP='resets interrupted Tomcat' npm run test:e2e:webview-devhost",
    "test:e2e:webview-install": "tsx scripts/run-vscode-install-e2e.ts",
    "bench:webview-bridge": "tsx gui/scripts/measure-webview-bridge.tsx",
    "test": "npm run test:unit",
    "gate:fast": "npm run lint && npm run test:unit",
    "gate:full": "tsx scripts/run-vscode-full-gate.ts",
    "accept:image": "tsx scripts/run-vscode-image-acceptance.ts",
    "accept:connectors": "tsx scripts/run-vscode-connectors-acceptance.ts",
    "package:vsix": "tsx scripts/package-vsix.ts",
    "verify:vsix": "tsx scripts/run-vscode-verify-vsix.ts"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.0.0",
    "@types/vscode": "1.101.0",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^3.9.2",
    "mocha": "^11.7.6",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "undici": "^7.29.0",
    "vitest": "^3.2.6",
    "yauzl": "^3.4.0"
  },
  "overrides": {
    "diff": "9.0.0",
    "serialize-javascript": "7.0.6"
  }
}
