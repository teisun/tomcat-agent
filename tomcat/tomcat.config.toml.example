# TOMCAT 配置示例
# 复制为 tomcat.config.toml 后按需修改。
# 环境变量 TOMCAT__*（如 TOMCAT__LLM__PROXY）会覆盖同名字段。

[ui]
# auto follows VS Code in the extension and the system locale in standalone CLI.
# Explicit zh-CN/en is shared with newly started CLI processes and windows.
language = "auto"

[log]
level = "warn"
file_enabled = false

[preflight]
# 进入 `tomcat chat` 后后台探测 search_files Tier1 依赖。
# 可通过 TOMCAT__PREFLIGHT__AUTO_INSTALL_SEARCH_TOOLS=false 覆盖。
auto_install_search_tools = true
# 进入 `tomcat chat` 后后台探测 git，可在后续 turn 中启用 checkpoint。
auto_install_git = true
# 是否显示 search_tools 预检的 [tools] 提示；默认后台执行但不打扰终端。
show_search_tools_ui = false
# 是否显示 git 预检的 [git] 提示；默认后台执行但不打扰终端。
show_git_ui = false

[checkpoint]
# 影子 git checkpoint 保留策略：最多保留最近 50 个、且不超过 7 天。
retention_max = 50
retention_days = 7

[llm]
# 这里只负责“选哪个模型”和全局运行时旋钮；
# 模型怎么连（api/provider/base_url/api_key_env）请写到 `models.toml`。
# 主模型：不写时为“未选择”，首次在设置页连接供应商后自动设为第一个配置成功的模型。
default_model = "gpt-5.6"
# 辅助模型：会话标题、回合标题与命令说明；默认 deepseek-v4-flash。
# title_model = "deepseek-v4-flash"
max_concurrent_requests = 4
retry_count = 3
stream_timeout_sec = 60
# proxy = "http://127.0.0.1:7890"
# api_base_fallback = "https://api.chatanywhere.tech"

[llm.files]
# OpenAI Files 上传兜底 TTL（秒）：
# - 默认 86400（24h）；
# - 0 表示不传 expires_after 字段（交给服务端默认策略）。
expires_after_seconds = 86400

[storage]
# 默认 ~/.tomcat/
# work_dir = "~/.tomcat/"

[agent]
id = "main"
# agent_dir = "~/.tomcat/agents/main/agent"
# workspace = "~/.tomcat/workspace-main"

[workspace]
workspace_roots = []
# 项目资源目录；仅允许项目内相对路径，默认 `.agents`。
# 可改为 `.team-agents` 或 `tools/agents`；改后重启 Tomcat 生效。
project_resource_dir = ".agents"

[connector.mcp]
# One policy for all MCP servers in this process, regardless of scope or transport.
# Defaults: 30s to start, 120s admission + renewable idle window per call,
# 16 concurrent calls PER source (not one shared pool across all sources).
# Older per-server mcp.json fields startupTimeoutMs/callTimeoutMs/maxConcurrentCalls,
# trusted, and integrity are ignored with a warning. They do not stop MCP loading.
# Tomcat does not rewrite mcp.json while loading; however, the next successful
# mcp.json save (Add, Remove, or a tool toggle) removes every unrecognized key.
# Keep comments and metadata that Tomcat does not own outside mcp.json.
startup_timeout_ms = 30000
call_timeout_ms = 120000
max_concurrent_calls = 16
# For a slower Playwright startup, explicitly set startup_timeout_ms = 60000
# here (applies to all MCP sources). Environment overrides use
# TOMCAT__CONNECTOR__MCP__STARTUP_TIMEOUT_MS and likewise for the other keys.

[plugin]
auto_load = []

[security]
default_plugin_permission_level = "restricted"
enable_audit_log = true
audit_log_retention_days = 90
enable_plugin_safety_scan = false

[wasm]

[primitive]
path_rules = []
bash_approval_required = []
bash_forbidden = []
auto_confirm = true

[tools.read]
max_bytes = 26214400

[tools.web_search]
# 按顺序尝试名单内的搜索后端，第一个正常返回即停止（包括空结果）。
# 不写名单时，使用 OpenAI 托管搜索及插件声明的默认后端（含 DeepSeek）；缺 Key 的后端跳过。
# backends = ["deepseek", "brave"]
# 只用一个后端：backends = ["deepseek"]
# 旧版 backend = "brave" 等同于只选 Brave；backend = "auto" 保持默认顺序。
# 旧版后端专属 *_base_url 字段已移除，忽略并告警。
count = 5
# Key 在「设置 → 工具 → 网页搜索」填写，或使用 `tomcat model key set <槽位>`。
# 保存 Key 不会把后端加入名单；不要在本文件里填写 Key。
