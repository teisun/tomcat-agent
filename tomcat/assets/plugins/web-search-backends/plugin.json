{
  "id": "tomcat.web-search-backends",
  "name": "web-search-backends",
  "version": "0.1.0",
  "description": "Official web_search backend plugin bundle",
  "author": "tomcat",
  "main": "main.js",
  "requiredPermissions": [
    "net:fetch"
  ],
  "requiredSecrets": [
    "TAVILY_API_KEY",
    "BRAVE_API_KEY",
    "SERPER_API_KEY",
    "DEEPSEEK_API_KEY",
    "OPENAI_API_KEY"
  ],
  "allowedHosts": [
    "api.tavily.com",
    "api.search.brave.com",
    "google.serper.dev",
    "api.deepseek.com",
    "api.openai.com"
  ],
  "requiredApiVersion": "1.0",
  "tags": [
    "web-search",
    "backend"
  ],
  "tools": [],
  "functions": [
    {
      "point": "web_search.backend",
      "function": "webSearchBackend",
      "metadata": {
        "backends": [
          { "id": "deepseek", "label": "DeepSeek", "secret": "DEEPSEEK_API_KEY", "host": "api.deepseek.com", "defaultAuto": true },
          { "id": "tavily", "label": "Tavily", "secret": "TAVILY_API_KEY", "host": "api.tavily.com", "defaultAuto": true },
          { "id": "brave", "label": "Brave", "secret": "BRAVE_API_KEY", "host": "api.search.brave.com", "defaultAuto": true },
          { "id": "serper", "label": "Serper", "secret": "SERPER_API_KEY", "host": "google.serper.dev", "defaultAuto": true },
          { "id": "mimo", "label": "MiMo", "model": "mimo/mimo-v2.6-pro", "defaultAuto": true },
          { "id": "openai", "label": "OpenAI", "secret": "OPENAI_API_KEY", "host": "api.openai.com", "defaultAuto": true }
        ]
      }
    }
  ],
  "events": [],
  "activation": "lazy"
}
